{
  "name": "@bigcommerce/catalyst-client",
  "description": "BigCommerce API client for Catalyst.",
  "version": "1.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.js,.cjs --max-warnings 0",
    "lint-fix": "eslint . --ext .ts,.js,.cjs --fix",
    "gen-types": "dotenv -e .env.local -- node scripts/types.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@0no-co/graphql.web": "^1.3.3",
    "std-env": "^4.2.0"
  },
  "devDependencies": {
    "@bigcommerce/eslint-config": "^2.13.1",
    "@bigcommerce/eslint-config-catalyst": "workspace:^",
    "@types/node": "^22.20.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
